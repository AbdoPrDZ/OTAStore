<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The whole app-specific external files dir, so downloaded APKs are
         shareable with the system package installer regardless of the
         sub-directory Android picks (Environment.DIRECTORY_DOWNLOADS is
         "Download", singular). -->
    <external-files-path name="external_files" path="." />
</paths>
